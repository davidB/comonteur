#!/usr/bin/env bash
#MISE description="Symlink addon/comonteur into Blender's user extensions repo for dev iteration"
# Dev-loop install: symlink so edits are live without reinstalling. End users get the
# packaged `extension install-file` path in comonteur:setup instead.
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
BLENDER_VERSION="5.2"
EXT_DIR="${HOME}/.config/blender/${BLENDER_VERSION}/extensions/user_default"

mkdir -p "$EXT_DIR"
ln -sfn "$REPO_ROOT/addon/comonteur" "$EXT_DIR/comonteur"

# Run with Blender closed: a GUI session exiting later writes its own prefs over this.
blender -b --python-expr \
  "import bpy; bpy.ops.preferences.addon_enable(module='bl_ext.user_default.comonteur'); bpy.ops.wm.save_userpref()" \
  >/dev/null 2>&1

echo "Linked $REPO_ROOT/addon/comonteur -> $EXT_DIR/comonteur (and enabled)"
