#!/usr/bin/env bash
#MISE description="Initialize a video project folder (additive, never overwrites)"
#USAGE arg "<dir>" help="project folder — created if missing, never overwritten" default="."
#USAGE flag "--git" help="git init (refused if already inside a work tree)"
#USAGE flag "--lfs" help="track .blend and media with Git LFS (needs --git)"
# Add-only and idempotent: the folder may already hold footage, a .blend, or another mise
# project. Existing files are kept, never overwritten and never deleted — the same rule the
# provenance model applies inside Blender (docs/architecture.md §4.1).
# `comonteur init` in Rust is M5.5 scope and will take over this task name.
set -euo pipefail

# These task files ARE the template: this script lives in the very directory it installs
# (skills/comonteur/templates/mise-tasks/comonteur/), so a project ends up with every task
# including this one — re-runnable by the human or the agent to fix or top up a project.
# readlink -f resolves the repo's mise-tasks/comonteur/* symlinks back here.
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
TEMPLATE="$(cd "$SCRIPT_DIR/../.." && pwd)"

# mise fills usage_* from the #USAGE headers. Run directly (no checkout, no mise task —
# `bash .claude/skills/comonteur/scripts/init <dir>`) and they are unset, so parse $@ too.
target="${usage_dir:-.}"
do_git=$([[ "${usage_git:-}" == "true" ]] && echo 1 || echo 0)
do_lfs=$([[ "${usage_lfs:-}" == "true" ]] && echo 1 || echo 0)
if [[ -z "${usage_dir:-}" ]]; then
  for arg in "$@"; do
    case "$arg" in
      --git) do_git=1 ;;
      --lfs) do_lfs=1 ;;
      -h|--help) echo "usage: init [dir] [--git] [--lfs]"; exit 0 ;;
      -*) echo "unknown flag: $arg" >&2; exit 2 ;;
      *) target="$arg" ;;
    esac
  done
fi

if (( do_lfs && ! do_git )); then
  echo "--lfs needs --git (LFS is a git feature). Re-run with both, or neither." >&2
  exit 2
fi

mkdir -p "$target"
target="$(cd "$target" && pwd)"
echo "Initializing $target"

created=()
kept=()

# copy <relative-path> — create if absent, keep otherwise. Never overwrites.
copy() {
  local rel="$1"
  if [[ -e "$target/$rel" ]]; then
    kept+=("$rel")
  else
    mkdir -p "$(dirname "$target/$rel")"
    cp "$TEMPLATE/$rel" "$target/$rel"
    created+=("$rel")
  fi
}

for d in assets audio captions compositions/frames lib renders thumbnail .comonteur; do
  mkdir -p "$target/$d"
done

# Tasks ship as files so a mise.toml the user already owns is never rewritten.
for task in "$TEMPLATE"/mise-tasks/comonteur/*; do
  copy "mise-tasks/comonteur/$(basename "$task")"
  chmod +x "$target/mise-tasks/comonteur/$(basename "$task")"
done

for f in narrative.yaml timeline.yaml meta.json .gitignore AGENTS.md CLAUDE.md; do
  copy "$f"
done

if [[ -e "$target/mise.toml" ]]; then
  kept+=("mise.toml")
  cat <<'EOF'

Your mise.toml was left untouched. Add this to it if you want the pinned tools:

  [tools]
  ffmpeg = "latest"

EOF
else
  copy "mise.toml"
fi

# Project name into the placeholders, only in files we just wrote.
name="$(basename "$target")"
for f in "${created[@]}"; do
  [[ "$f" == *.md ]] && sed -i "s/__PROJECT_NAME__/$name/g" "$target/$f"
done

if (( do_git )); then
  if git -C "$target" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo
    echo "Refusing --git: $target is already inside a git work tree."
    echo "Nothing else was skipped; drop --git and commit however that repo does it."
    exit 1
  fi
  git -C "$target" init -q
  created+=(".git/")
  if (( do_lfs )); then
    git -C "$target" lfs install --local
    git -C "$target" lfs track "*.blend" "assets/**" "audio/**"
    created+=(".gitattributes")
  fi
fi

echo
(( ${#created[@]} )) && printf 'created: %s\n' "$(IFS=' '; echo "${created[*]}")"
(( ${#kept[@]} ))    && printf 'kept:    %s\n' "$(IFS=' '; echo "${kept[*]}")"

cat <<EOF

Next:
  cd $target
  mise trust                    # these task files are new to mise
  mise tasks                    # the comonteur:* menu — setup/doctor are in there too,
                                #   so fixing an install later needs nothing but this project
  mise run comonteur:doctor     # is the toolchain usable?
  mise run comonteur:setup      # ... if it says something is missing

Then create master.blend, open it in Blender, and leave it open — the agent works
against that live session.
EOF
