#!/usr/bin/env bash
#MISE description="One-time setup: Blender add-on, Blender's MCP server, then doctor"
#USAGE flag "--ref <ref>" help="git tag/branch/sha to install from" default="main"
#MISE env={BLENDER_PIN = "5.2"}
# Installs everything that does not live inside Blender's own UI, without assuming a clone of
# this repository: a user has the installed skill (npx skills add) and nothing else.
#
# There is nothing to compile or install outside Blender any more: the comonteur:* ingest and
# reconcile tasks are `uv run --script` Python that ships with the skill and runs in place
# (docs/mcp-and-tooling.md §8.2), so this only has to deal with the Blender side. The source
# archive for <ref> is fetched only when the add-on needs it. In a checkout, the checkout wins
# and nothing is downloaded. Idempotent — safe to re-run after an update.
set -euo pipefail

REF="${usage_ref:-main}"
[[ -n "${1:-}" ]] && REF="$1"   # also usable directly: bash scripts/setup v0.1.0
REPO="https://github.com/davidB/comonteur"
EXT_DIR="${HOME}/.config/blender/${BLENDER_PIN:-5.2}/extensions/user_default"
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"

# In a checkout (skills/comonteur/templates/mise-tasks/comonteur/ -> repo root), use it: no
# download, and add-on edits stay live through the symlink.
CHECKOUT=""
if [[ -f "$SCRIPT_DIR/../../../../../addon/comonteur/blender_manifest.toml" ]]; then
  CHECKOUT="$(cd "$SCRIPT_DIR/../../../../.." && pwd)"
  echo "==> Using this checkout: $CHECKOUT"
fi

work=""
cleanup() { [[ -n "$work" ]] && rm -rf "$work"; }
trap cleanup EXIT

# Source tree to install from: the checkout, or an extracted archive of <ref>, fetched once.
source_tree() {
  if [[ -n "$CHECKOUT" ]]; then echo "$CHECKOUT"; return; fi
  if [[ -z "$work" ]]; then
    work="$(mktemp -d)"
    echo "==> Fetching source for $REF" >&2
    curl -fsSL "$REPO/archive/$REF.tar.gz" | tar xz -C "$work" --strip-components=1
  fi
  echo "$work"
}

# Enabling is `bpy.ops` only — there is no `--command extension enable`. Background Blender,
# so run setup with the GUI closed or a later GUI exit overwrites these preferences.
enable_addon() {
  blender -b --python-expr \
    "import bpy; bpy.ops.preferences.addon_enable(module='$1'); bpy.ops.wm.save_userpref()" \
    >/dev/null 2>&1
}

echo "==> Installing the comonteur Blender add-on"
addon_src="$(source_tree)/addon/comonteur"
if [[ -n "$CHECKOUT" ]]; then
  # Symlink, not install-file: the dev loop wants edits live without reinstalling.
  mkdir -p "$EXT_DIR"
  ln -sfn "$addon_src" "$EXT_DIR/comonteur"
  echo "    linked $EXT_DIR/comonteur -> $addon_src"
elif command -v blender >/dev/null 2>&1; then
  zipdir="$(mktemp -d)"
  blender --command extension build --source-dir "$addon_src" --output-dir "$zipdir" >/dev/null
  blender --command extension install-file -r user_default -e "$zipdir"/comonteur-*.zip >/dev/null
  rm -rf "$zipdir"
  echo "    installed into Blender's user_default repository ($REF)"
else
  mkdir -p "$EXT_DIR"
  rm -rf "$EXT_DIR/comonteur"
  cp -r "$addon_src" "$EXT_DIR/comonteur"
  echo "    copied to $EXT_DIR/comonteur ($REF) — no blender on PATH to install it properly"
fi

if command -v blender >/dev/null 2>&1; then
  enable_addon bl_ext.user_default.comonteur   # no-op when install-file -e already did it

  echo "==> Installing Blender's MCP add-on"
  # Same repository id drag-and-drop creates, so an add-on already installed by hand is found
  # here rather than duplicated.
  # ponytail: `extension install` takes no version, so this tracks the Lab repo's latest while
  # install-mcp pins the server to BLENDER_MCP_VERSION. Pin both via install-file if they skew.
  blender --command extension repo-list 2>/dev/null | grep -q '^lab_blender_org:' \
    || blender --command extension repo-add lab_blender_org \
         --name "Blender Lab" --url https://lab.blender.org/ >/dev/null
  if blender --command extension list 2>/dev/null | grep -q '^ *mcp \[installed\]'; then
    echo "    already installed"
  else
    blender --command extension install mcp --sync --enable \
      || echo "    ! failed — install it by hand: https://www.blender.org/lab/mcp-server/"
  fi
fi

echo "==> Installing Blender's official MCP server"
bash "$(source_tree)/mise-tasks/install-mcp"

echo
bash "$SCRIPT_DIR/doctor" || true   # report; the list below is usually the fix

cat <<EOF

Still yours to do:
  - Install Blender 5.2 LTS if doctor flagged it — https://www.blender.org/download/lts/
    then re-run this, so the add-ons get installed and enabled.
  - Run this with Blender closed: add-ons are enabled in a background Blender, and a GUI
    session exiting afterwards writes its own preferences over that.

Then, in your video project folder:
  mise run comonteur:init .        (or: bash $SCRIPT_DIR/init .)
EOF
